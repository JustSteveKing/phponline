---
import Layout from "@/layouts/Layout.astro";
import { Sidebar, SidebarCard } from "@/components";
import { getCollection, type CollectionEntry } from "astro:content";
import { slugify } from "@/utils/slugify";

export async function getStaticPaths() {
    const allVideos: CollectionEntry<"videos">[] = await getCollection("videos");
    
    return allVideos.map((video: CollectionEntry<"videos">) => ({
        params: { slug: video.id },
        props: { video, allVideos },
    }));
}

const { video, allVideos } = Astro.props as { video: CollectionEntry<"videos">, allVideos: CollectionEntry<"videos">[] };
const { title, channel, pubDate, videoId, content } = video.data;

const moreFromChannel = allVideos
    .filter((v: CollectionEntry<"videos">) => v.data.channel === channel && v.id !== video.id)
    .sort((a: CollectionEntry<"videos">, b: CollectionEntry<"videos">) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 4);

const breadcrumbs = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://phponline.dev" },
        { "@type": "ListItem", "position": 2, "name": "Videos", "item": "https://phponline.dev/videos" },
        { "@type": "ListItem", "position": 3, "name": channel, "item": `https://phponline.dev/videos/${slugify(channel)}` },
        { "@type": "ListItem", "position": 4, "name": title, "item": `https://phponline.dev/videos/watch/${video.id}` }
    ]
};
---

<Layout 
    title={`${title} | phponline.dev`}
    description={`Watch ${title} from ${channel} on phponline.dev`}
    sd={[breadcrumbs]}
>
    <div class="max-w-6xl mx-auto">
        <!-- Video Player Section -->
        <div class="relative aspect-video w-full rounded-3xl overflow-hidden bg-ink-900 shadow-2xl mb-12">
            <iframe
                src={`https://www.youtube.com/embed/${videoId}?autoplay=1`}
                title={title}
                class="absolute inset-0 w-full h-full border-0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
            ></iframe>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
            <!-- Main Content -->
            <div class="lg:col-span-8">
                <div class="flex items-center gap-4 mb-6">
                    <span class="px-4 py-1.5 rounded-full bg-php-600 text-white text-meta font-semibold uppercase tracking-wide shadow-lg shadow-php-600/30">
                        Now Playing
                    </span>
                    <a href={`/videos/${slugify(channel)}`} class="text-ink-400 hover:text-php-600 font-bold text-xs uppercase tracking-widest transition-colors">
                        {channel}
                    </a>
                    <span class="text-ink-300 dark:text-ink-600">•</span>
                    <time class="text-ink-400 font-bold text-xs uppercase tracking-widest">
                        {pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                    </time>
                </div>

                <h1 class="text-3xl md:text-5xl font-black text-ink-900 dark:text-white leading-tight mb-8">
                    {title}
                </h1>

                <SidebarCard title="About this Video" class="mb-12">
                    <div class="text-ink-600 dark:text-ink-400 leading-relaxed font-medium space-y-4 whitespace-pre-wrap">
                        {content || "No description provided for this video."}
                    </div>
                </SidebarCard>
            </div>

            <!-- Sidebar -->
            <Sidebar top="top-8">
                <SidebarCard title={`More from ${channel}`}>
                    <div class="space-y-6">
                        {moreFromChannel.map((v: CollectionEntry<"videos">) => (
                            <a href={`/videos/watch/${v.id}`} class="group flex gap-4">
                                <div class="relative w-32 shrink-0 aspect-video rounded-xl overflow-hidden bg-ink-100 dark:bg-ink-800 border border-ink-200/50 dark:border-ink-800/50">
                                    <img src={v.data.thumbnail} alt="" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                    <div class="absolute inset-0 bg-php-600/0 group-hover:bg-php-600/10 transition-colors"></div>
                                </div>
                                <div class="min-w-0">
                                    <h4 class="text-xs font-black text-ink-900 dark:text-white line-clamp-2 group-hover:text-php-600 transition-colors uppercase leading-tight">
                                        {v.data.title}
                                    </h4>
                                    <time class="text-meta font-medium text-ink-400 uppercase tracking-wide mt-2 block">
                                        {v.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                                    </time>
                                </div>
                            </a>
                        ))}
                    </div>

                    <a 
                        href={`/videos/${slugify(channel)}`}
                        class="flex items-center justify-center w-full py-4 rounded-2xl border-2 border-ink-100 dark:border-ink-800 text-ink-900 dark:text-white text-meta font-semibold uppercase tracking-wide hover:bg-ink-50 dark:hover:bg-ink-800 transition-all mt-8"
                    >
                        View Channel Feed
                    </a>
                </SidebarCard>
            </Sidebar>
        </div>
    </div>
</Layout>
