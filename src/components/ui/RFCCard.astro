---
import { StatusBadge } from "@/components";
import type { CollectionEntry } from "astro:content";

interface Props {
	item: CollectionEntry<"news">;
    class?: string;
}

const { item, class: className } = Astro.props;

const description = item.data.content
    ? item.data.content
          .replace(/<\/?[^>]+(>|$)/g, "")
          .replace(/&nbsp;/g, " ")
          .substring(0, 200) + "..."
    : "No description available for this RFC proposal.";
---

<a 
    href={`/news/${item.id}`}
    class:list={["flex flex-col h-full bg-white dark:bg-[var(--color-ink-900)] border border-ink-100 dark:border-ink-800/50 rounded-2xl p-8 hover:shadow-2xl hover:-translate-y-2 hover:border-php-100 dark:hover:border-php-900/50 transition-all duration-500 group", className]}
>
    <div class="flex items-center justify-between mb-6">
        <StatusBadge status={item.data.status} />
        <time class="text-meta font-semibold text-ink-400 uppercase tracking-wide">
            {item.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
        </time>
    </div>
    
    <h3 class="text-xl font-black text-ink-900 dark:text-white mb-4 group-hover:text-php-600 transition-colors leading-tight uppercase">
        {item.data.title.replace(/\[.*\]\s*/, "")}
    </h3>
    
    <p class="text-ink-500 dark:text-ink-400 text-sm mb-8 line-clamp-3 font-medium leading-relaxed">
        {description}
    </p>
    
    <div class="mt-auto pt-6 border-t border-ink-50 dark:border-ink-800/50 flex items-center justify-between">
        <span class="text-meta font-semibold uppercase tracking-wide text-php-600">
            View Proposal
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-php-600 transition-transform group-hover:translate-x-1">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
    </div>
</a>
